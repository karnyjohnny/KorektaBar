#include "resource.h"

IDI_APP_ICON ICON "../../assets/KorektaBar.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041504b0"
        BEGIN
            VALUE "CompanyName", "KorektaBar"
            VALUE "FileDescription", "KorektaBar - Natywny korektor i formater języka polskiego"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "KorektaBar"
            VALUE "OriginalFilename", "KorektaBar.exe"
            VALUE "ProductName", "KorektaBar"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0415, 1200
    END
END
